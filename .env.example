# Supabase (Phase 6 auth). Both values are safe to expose to the browser.
# Copy this file to .env.local and fill in your own values. Read them from your
# Supabase project settings, or from `npx supabase status` for a local stack.
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Private-pilot UI gate only. Keep false by default. Database invitations remain the security boundary.
VITE_MANAGER_SIGNUP_ENABLED=false

# Never add SUPABASE_SERVICE_ROLE_KEY here or anywhere with a VITE_ prefix —
# VITE_ variables are bundled into the client.
